{
  "name": "camera-mirror",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:https": "HTTPS=true tsx server.ts",
    "dev:next": "next dev",
    "build": "next build",
    "cert": "mkdir -p .cert && openssl req -x509 -newkey rsa:2048 -nodes -sha256 -days 365 -keyout .cert/local-key.pem -out .cert/local-cert.pem -subj /CN=local-camera-monitor -addext subjectAltName=DNS:localhost,IP:127.0.0.1,IP:10.92.3.53",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vercel/functions": "^3.9.9",
    "next": "^16.3.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
